/**
  * @brief GPIO Initialization Function
  * @param None
  * @retval None
  */
static void MX_GPIO_Init(void)
{
  GPIO_InitTypeDef GPIO_InitStruct = {0};
  /* USER CODE BEGIN MX_GPIO_Init_1 */
  /* USER CODE END MX_GPIO_Init_1 */

  /* GPIO Ports Clock Enable */
  __HAL_RCC_GPIOC_CLK_ENABLE();
  __HAL_RCC_GPIOH_CLK_ENABLE();
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_GPIOB_CLK_ENABLE();

  /*Configure GPIO pin Output Level */
  HAL_GPIO_WritePin(LCD_RESET_GPIO_Port, LCD_RESET_Pin, GPIO_PIN_RESET);

  /*Configure GPIO pin Output Level */
  HAL_GPIO_WritePin(LCD_DC_GPIO_Port, LCD_DC_Pin, GPIO_PIN_RESET);

  /*Configure GPIO pin Output Level */
  HAL_GPIO_WritePin(GPIOB, LCD_CS_Pin|SD_CS_Pin, GPIO_PIN_RESET);

  /*Configure GPIO pin : B1_Pin */
  GPIO_InitStruct.Pin = B1_Pin;
  GPIO_InitStruct.Mode = GPIO_MODE_IT_FALLING;
  GPIO_InitStruct.Pull = GPIO_NOPULL;
  HAL_GPIO_Init(B1_GPIO_Port, &GPIO_InitStruct);

  /*Configure GPIO pin : LCD_RESET_Pin */
  GPIO_InitStruct.Pin = LCD_RESET_Pin;
  GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  GPIO_InitStruct.Pull = GPIO_NOPULL;
  GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_MEDIUM;
  HAL_GPIO_Init(LCD_RESET_GPIO_Port, &GPIO_InitStruct);

  /*Configure GPIO pin : LCD_DC_Pin */
  GPIO_InitStruct.Pin = LCD_DC_Pin;
  GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  GPIO_InitStruct.Pull = GPIO_NOPULL;
  GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_MEDIUM;
  HAL_GPIO_Init(LCD_DC_GPIO_Port, &GPIO_InitStruct);

  /*Configure GPIO pins : LCD_CS_Pin SD_CS_Pin */
  GPIO_InitStruct.Pin = LCD_CS_Pin|SD_CS_Pin;
  GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
  GPIO_InitStruct.Pull = GPIO_NOPULL;
  GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_MEDIUM;
  HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);

  /* USER CODE BEGIN MX_GPIO_Init_2 */
  /* USER CODE END MX_GPIO_Init_2 */
}

/* USER CODE BEGIN 4 */

/* Panel con borde grueso (2 px) */
static void Panel(unsigned int x, unsigned int y, unsigned int w, unsigned int h, unsigned int c)
{
	Rect(x, y, w, h, c);
	Rect(x + 1, y + 1, w - 2, h - 2, c);
}

/* Dibuja toda la interfaz (pantalla 320x240 horizontal) */
static void GUI_Dibujar(void)
{
	/* Valores constantes a mostrar */
	char temp[] = "36.8";
	char fc[]   = "72";
	char spo2[] = "98";

	/* ---------- Parte 1: fondo, barra de título, paneles y tiles ---------- */
	FillRect(4, 4, 312, 32, COL_TITLE);              // barra de título
	Rect(4, 4, 312, 32, COL_CYAN);

	/* Cruz médica (icono dibujado con rectángulos) */
	FillRect(10, 8, 24, 24, COL_WHITE);
	FillRect(20, 11, 4, 18, COL_RED);
	FillRect(13, 18, 18, 4, COL_RED);

	/* Tiles decorativos a la derecha del título */
	FillRect(270, 14, 8, 8, COL_RED);
	FillRect(282, 14, 8, 8, COL_ORANGE);
	FillRect(294, 14, 8, 8, COL_YELLOW);
	FillRect(306, 14, 8, 8, COL_GREEN);

	Panel(4, 42, 154, 130, COL_CYAN);                // panel temperatura
	Panel(162, 42, 154, 130, COL_RED);               // panel frecuencia cardíaca
	Panel(4, 178, 312, 58, COL_YELLOW);              // barra inferior (SpO2 + estado)

	/* ---------- Parte 2: texto ---------- */
	/* Título: nombre del dispositivo */
	LCD_Print("SIGNOS VITALES", 44, 12, 2, COL_WHITE, COL_TITLE);

	/* Panel 1: temperatura */
	LCD_Print("TEMP", 14, 52, 2, COL_CYAN, COL_BG);
	LCD_Print(temp, 14, 92, 3, COL_WHITE, COL_BG);
	Rect(14, 142, 5, 5, COL_WHITE);                  // símbolo de grado
	LCD_Print("C", 24, 138, 2, COL_WHITE, COL_BG);

	/* Panel 2: frecuencia cardíaca */
	LCD_Print("FC", 172, 52, 2, COL_RED, COL_BG);
	LCD_Print(fc, 172, 92, 3, COL_WHITE, COL_BG);
	LCD_Print("bpm", 172, 138, 2, COL_WHITE, COL_BG);

	/* Barra inferior: SpO2 y estado */
	LCD_Print("SpO2", 14, 198, 2, COL_CYAN, COL_BG);
	LCD_Print(spo2, 90, 192, 3, COL_WHITE, COL_BG);
	LCD_Print("%", 142, 198, 2, COL_WHITE, COL_BG);
	FillRect(164, 200, 12, 12, COL_GREEN);           // indicador de estado
	LCD_Print("ESTABLE", 182, 198, 2, COL_GREEN, COL_BG);

	/* ---------- Parte 3: imágenes (bitmaps RGB565 de iconos.h) ---------- */
	LCD_Bitmap(124, 48, 24, 80, icono_termometro);
	LCD_Bitmap(276, 50, 32, 32, icono_corazon_roto);
}
